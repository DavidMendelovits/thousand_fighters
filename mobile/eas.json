{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GAME_URL": "https://thousand-fighters-game.vercel.app"
      },
      "android": { "buildType": "apk" }
    },
    "simulator": { "extends": "preview", "ios": { "simulator": true } },
    "production": { "autoIncrement": true }
  }
}
